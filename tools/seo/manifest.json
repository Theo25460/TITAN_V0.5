{
  "$comment": "Contrat SEO de titan-app.fr, versionné avec le code. Lu par tools/seo-guard.mjs, expliqué dans docs/seo/SEO_GUARD.md. Il se modifie dans une pull request : le diff de ce fichier EST la revue d'un changement de routage.",
  "version": 1,
  "origin": "https://titan-app.fr",
  "referenceDate": "2026-11-26",
  "thresholds": {
    "$comment": "Mesurés sur la référence de production du 26/11/2026 : la plus petite page de chaque groupe fixe son plancher (minWords) ; une baisse de plus de 25 % du texte principal d'une page demande une revue, au-delà de 60 % elle bloque. Le poids d'une page (HTML + CSS/JS du site, non compressés) peut croître de 30 % et d'au moins 30 Ko avant revue : les octets sont reproductibles, les temps ne le sont pas.",
    "contentDropReview": 0.25,
    "contentDropBlock": 0.6,
    "linksDropReview": 0.3,
    "minWords": 100,
    "titleMax": 65,
    "descriptionMin": 50,
    "descriptionMax": 170,
    "weightIncreaseReview": 0.3,
    "weightIncreaseMinBytes": 30000
  },
  "groups": {
    "marketing": {
      "indexable": true,
      "criticality": "important",
      "minWords": 300,
      "ctas": [
        "/onboarding"
      ],
      "variants": [
        "html",
        "slash"
      ],
      "description": "Accueil, fonctionnalités, offres, coachs, catalogue des sports."
    },
    "guide": {
      "indexable": true,
      "criticality": "normal",
      "minWords": 250,
      "ctas": [
        "/onboarding"
      ],
      "variants": [
        "html",
        "slash"
      ],
      "description": "Guides éditoriaux qui répondent à une intention de recherche."
    },
    "support": {
      "indexable": true,
      "criticality": "normal",
      "minWords": 100,
      "variants": [
        "html",
        "slash"
      ],
      "description": "Assistance, nouveautés, partenariats."
    },
    "legal": {
      "indexable": true,
      "criticality": "normal",
      "minWords": 100,
      "variants": [
        "html",
        "slash"
      ],
      "description": "Textes juridiques et suppression de compte (exigence Google Play)."
    },
    "conversion": {
      "indexable": false,
      "criticality": "critical",
      "description": "Inscription et connexion Web : accessibles sans compte, noindex volontaire."
    },
    "app": {
      "indexable": false,
      "criticality": "normal",
      "description": "Écrans privés de l'application : coquilles noindex, données chargées avec la session de l'utilisateur seulement."
    },
    "technical": {
      "indexable": false,
      "criticality": "normal",
      "description": "Fichiers lus par les robots, les navigateurs, les stores et la Search Console."
    },
    "redirect": {
      "indexable": false,
      "criticality": "normal",
      "description": "URL historiques : un seul saut permanent vers leur équivalent."
    },
    "blocked": {
      "indexable": false,
      "criticality": "critical",
      "description": "Fichiers du dépôt qui ne doivent jamais être publiés."
    },
    "missing": {
      "indexable": false,
      "criticality": "critical",
      "description": "URL inconnues : une vraie 404."
    },
    "gone": {
      "indexable": false,
      "criticality": "normal",
      "description": "Pages supprimées sans équivalent : 404 ou 410, jamais une redirection vers l'accueil."
    }
  },
