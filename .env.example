# Variables serveur Netlify uniquement. Ne jamais placer de vraies valeurs ici.
PADDLE_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Compatibilite temporaire si SUPABASE_SECRET_KEY n'est pas encore disponible.
SUPABASE_SERVICE_ROLE_KEY=

# Listes CSV recommandees pour identifier explicitement l'offre TITAN+.
PADDLE_ELITE_PRODUCT_IDS=
PADDLE_ELITE_PRICE_IDS=

# Outil local tools/supabase-backup.ps1 uniquement.
SUPABASE_DB_URL=

# Serveur local tools/local-static-server.mjs (facultatif).
HOST=127.0.0.1
PORT=8080
