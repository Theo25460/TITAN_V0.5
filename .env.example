# Variables serveur Netlify uniquement. Ne jamais placer de vraies valeurs ici.
PADDLE_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Compatibilite temporaire si SUPABASE_SECRET_KEY n'est pas encore disponible.
SUPABASE_SERVICE_ROLE_KEY=

# Listes CSV recommandees pour identifier explicitement l'offre TITAN+.
PADDLE_ELITE_PRODUCT_IDS=
PADDLE_ELITE_PRICE_IDS=

# V1.7.7 - calcul d'itineraire (functions/route-plan.mjs). Vide = fonction eteinte (503 ROUTING_NOT_CONFIGURED).
# ROUTING_PROVIDER : openrouteservice ou graphhopper. ROUTING_API_KEY : cle du compte fournisseur (secret).
# ROUTING_BASE_URL : facultatif, adresse https d'une instance auto-hebergee (la cle devient facultative).
# La fonction lit aussi SUPABASE_URL et SUPABASE_PUBLISHABLE_KEY (cle publique) pour verifier la session et le quota.
ROUTING_PROVIDER=
ROUTING_API_KEY=
ROUTING_BASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# V1.7.7 - points utiles OpenStreetMap (functions/poi-nearby.mjs). Vide = fonction eteinte (503 POI_NOT_CONFIGURED).
# Adresse https complete de l'instance Overpass choisie par le proprietaire (aucune adresse par defaut dans le code).
POI_OVERPASS_URL=

# Outil local tools/supabase-backup.ps1 uniquement.
SUPABASE_DB_URL=

# Serveur local tools/local-static-server.mjs (facultatif).
HOST=127.0.0.1
PORT=8080
